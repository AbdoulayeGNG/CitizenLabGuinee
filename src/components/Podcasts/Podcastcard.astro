---
import type { Podcast } from "~/types/podcasts";
import microphone from "~/assets/images/microphone.jpg"

interface Props {
  podcast: Podcast;
}

const { podcast } = Astro.props;

const maxWords : number = 5; 
const truncate = (text: string, numWords: number) => {
  if (!text) return "";
  const words = text.split(/\s+/); 
  if (words.length <= numWords) return text;
  return words.slice(0, numWords).join(" ") + "[...]";
};
---

<a href={`/podcasts/${podcast.slug}`} class="block h-full group">
  <article
    class="podcast-card bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 cursor-pointer flex flex-col h-96"
    data-category={podcast.category}
  >
    <!-- Image -->
    <div class="relative flex-1 overflow-hidden">
      <img
        src={podcast.coverImage || microphone.src}
        alt={podcast.title}
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
      />
    </div>

    <!-- Titre -->
    <div class="p-6 flex items-center justify-between bg-white">
      <h3 class="text-lg font-bold text-green-800 group-hover:text-green-600 transition-colors line-clamp-2">
        {podcast.title}
      </h3>
      <span class="inline-flex items-center justify-center w-10 h-10 bg-green-50 group-hover:bg-green-700 rounded-full transition-all duration-300 flex-shrink-0 ml-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-5 h-5 text-green-600 group-hover:text-white transition-colors"
        >
          <path d="M7 17L17 7" />
          <path d="M7 7h10v10" />
        </svg>
      </span>
    </div>
  </article>
</a>
